include README.md
include pyproject.toml
include MANIFEST.in
recursive-include src *.py
recursive-include configs *.yaml
recursive-include analysis *.py *.md *.json
recursive-include scripts *.py
recursive-include tests *.py
global-exclude __pycache__ *.py[cod]
global-exclude */.ipynb_checkpoints/*
global-exclude *.pt *.pth *.safetensors *.jsonl
include examples/raw_smoke.jsonl
include examples/news_dev_smoke_20261019.json
prune .git
prune .venv
prune build
prune dist
prune runs
prune reports
prune artifacts
prune models
include tests/fixtures/executed_d1_seed17.pt
recursive-include tests/fixtures *.json
